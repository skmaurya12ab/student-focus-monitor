# ============================================================
# Student Focus Monitor — Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env
# ============================================================

# Application Environment (development | staging | production)
APP_ENV=development

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration (Docker Compose & Backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_focus_monitor
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_focus_monitor

# Frontend Service Configuration
VITE_API_BASE_URL=http://localhost:8000
